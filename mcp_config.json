{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": ["-q", "mcp-server-fetch"]
    },
    "time": {
      "command": "uvx",
      "args": ["-q", "mcp-server-time"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "env": {
        "MEMORY_FILE_PATH": "./memory.jsonl"
      }
    },
    "context_folder": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./context"
      ]
    }
  }
}
