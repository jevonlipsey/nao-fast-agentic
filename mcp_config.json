{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": ["-q", "mcp-server-fetch"]
    },
    "time": {
      "command": "uvx",
      "args": ["-q", "mcp-server-time"]
    },
    "memory": {
      "command": "mcp-server-memory",
      "args": [],
      "env": {
        "MEMORY_FILE_PATH": "./memory.jsonl"
      }
    },
    "context_folder": {
      "command": "mcp-server-filesystem",
      "args": [
        "./context"
      ]
    },
    "vision_reader": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "./mcp-servers/vision_reader",
        "server.py"
      ]
    },
    "nao_actuation": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "./mcp-servers/nao_actuation",
        "server.py"
      ]
    }
  }
}
